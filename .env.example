# ─── Supabase ──────────────────────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Dashboard → Project Settings → API → Project URL
PROJECT_URL=https://<project-ref>.supabase.co

# Dashboard → Project Settings → API → anon / publishable key
# (Safe to expose in browser. NEVER commit the service_role key.)
PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase CLI bootstrap ────────────────────────────────────────────────
# supabase login
# supabase init
# supabase link --project-ref <project-ref>

# ─── Jamendo (public music catalog API) ────────────────────────────────────
# Register at https://developer.jamendo.com → My Apps
JAMENDO_CLIENT_ID=xxxxxxxx
JAMENDO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
